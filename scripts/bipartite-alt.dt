.wipe
.time reset

.flow Arc /Users/mcsherry/Projects/datasets/flowlog/roadNet-CA/Arc.csv
.flow Source /Users/mcsherry/Projects/datasets/flowlog/netflix/Source.csv
.time roadca bipartite-alt loaded
Tmp(x) :- Arc(x, y).
ArcT(y, x) :- Tmp(x), Arc(x, y).
Zero(x) :- Source(x).
One(y)  :- Zero(x), Arc(x, y).
One(x)  :- Zero(y), ArcT(y, x).
Zero(y) :- One(x), Arc(x, y).
Zero(x) :- One(y), ArcT(y, x).
.time roadca bipartite-alt complete
.list
.note flowlog result: [One]: ((), (), 1957027)
.note flowlog result: [Zero]: ((), (), 1957027)
.note flowlog result: BipartiteViolation: ((), (), 1957027)
.wipe

