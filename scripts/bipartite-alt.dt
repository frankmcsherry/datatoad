ArcT(y, x) :- Tmp(x), Arc(x, y).
Zero(x) :- Source(x).
One(y)  :- Zero(x), Arc(x, y).
One(x)  :- Zero(y), ArcT(y, x).
Zero(y) :- One(x), Arc(x, y).
Zero(x) :- One(y), ArcT(y, x).
.time netflix bipartite-alt complete
.list
